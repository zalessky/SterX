<script>var safeCategories = ["engine-oils","masla-dlya-sto","plastichnye-smazki","okhlazhdayushchie-zhidkosti","transmissionnye-masla","tormoznye-zhidkosti","other","avtokhimiya-i-avtokosmetika","bigtech-motornye-masla","industrial-motornye-masla"];</script>
<script>
    // фикс пеновского дизайна для мобайла на подборщик продуктов
    $('.bx-touch .filter-form__title').addClass('text-center');
    $('.bx-touch .filter-form__title h3').addClass('btn btn-lg m-auto');
    $('.bx-touch .filter-form__wrapper').addClass('show');

    // фикс пустых категорий, оставляем только те, что есть в safeCategories
    var safeLinks = document.querySelectorAll('.footer__item-wrapper a[href*="/catalog/"]');
    safeLinks.forEach(function(link) {
        var href = link.getAttribute('href');
        if (!safeCategories.some(category => href.includes(category))) {
            link.parentNode.classList.add('d-none', 'empty_no_products');
        }
    });
</script>

